    <DTS:Executable
      DTS:refId="Package\SQL - Truncate Temp Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{CC1FE5F3-6300-4C82-ADFE-13E3F39E63CE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL - Truncate Temp Table"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; Â© 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2D381065-E79F-4C03-9FF3-91EC3ADF5E8C}"
          SQLTask:SqlStatementSource="DELETE FROM temp.ods_order WHERE batch_id = COALESCE((SELECT MAX(batch_id) FROM control.etl_log WHERE step_name = 'LOAD_ODS_ORDER' AND status = 'RUNNING'), (SELECT MAX(batch_id) FROM raw.raw_order));" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
