            <component
              refId="Package\DFT - RAW Order to ODS Order\SRC - RAW Order"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="SRC - RAW Order"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    order_id,
    customer_id,
    restaurant_id,
    delivery_partner_id,
    order_timestamp,
    subtotal_amount,
    discount_amount,
    delivery_fee,
    total_amount,
    is_cod,
    is_cancelled,
    batch_id,
    source_file_name,
    source_row_number,

    -- 1. Cờ Order ID: Bắt đầu bằng ORD, đúng 15 ký tự, 12 ký tự sau là số
    CASE 
        WHEN order_id LIKE 'ORD%' 
         AND LEN(TRIM(order_id)) = 15 
         AND SUBSTRING(TRIM(order_id), 4, 12) NOT LIKE '%[^0-9]%' 
        THEN 1 ELSE 0 
    END AS is_valid_order_pattern,

    -- 2. Cờ Customer ID: Bắt đầu bằng CUST, đúng 10 ký tự, 6 ký tự sau là số
    CASE 
        WHEN customer_id LIKE 'CUST%' 
         AND LEN(TRIM(customer_id)) = 10 
         AND SUBSTRING(TRIM(customer_id), 5, 6) NOT LIKE '%[^0-9]%' 
        THEN 1 ELSE 0 
    END AS is_valid_customer_pattern,

    -- 3. Cờ Restaurant ID: Bắt đầu bằng REST, đúng 9 ký tự, 5 ký tự sau là số
    CASE 
        WHEN restaurant_id LIKE 'REST%' 
         AND LEN(TRIM(restaurant_id)) = 9 
         AND SUBSTRING(TRIM(restaurant_id), 5, 5) NOT LIKE '%[^0-9]%' 
        THEN 1 ELSE 0 
    END AS is_valid_restaurant_pattern,

    -- 4. Cờ Delivery Partner ID: Cho phép NULL/rỗng; nếu có thì bắt đầu bằng DP, 7 ký tự, 5 số sau
    CASE 
        WHEN delivery_partner_id IS NULL OR TRIM(delivery_partner_id) = '' THEN 1
        WHEN delivery_partner_id LIKE 'DP%' 
         AND LEN(TRIM(delivery_partner_id)) = 7 
         AND SUBSTRING(TRIM(delivery_partner_id), 3, 5) NOT LIKE '%[^0-9]%' 
        THEN 1 ELSE 0 
    END AS is_valid_delivery_partner_pattern

FROM raw.raw_order
WHERE batch_id = COALESCE(
    (SELECT MAX(batch_id) FROM control.etl_log WHERE step_name = 'LOAD_ODS_ORDER' AND status = 'RUNNING'),
    (SELECT MAX(batch_id) FROM raw.raw_order)
);</property>
