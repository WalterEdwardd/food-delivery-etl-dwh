model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["MCP-PBIModeling"]

annotation PBI_QueryOrder = ["Batch","Step","Error","Warning","Reconciliation","Audit"]

ref table Batch
ref table Step
ref table Error
ref table Warning
ref table Audit
ref table _Measures
ref table Reconciliation

ref cultureInfo en-US

