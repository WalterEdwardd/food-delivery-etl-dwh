	/// Dynamic secondary context for Step Execution card showing Success, Partial, Failed, and Running breakdown
	measure 'Step Execution Subtext' =
			
			VAR _Success = CALCULATE(COUNTROWS('Step'), 'Step'[step_status] = "SUCCESS") + 0
			VAR _Partial = CALCULATE(COUNTROWS('Step'), 'Step'[step_status] = "PARTIAL") + 0
			VAR _Failed  = CALCULATE(COUNTROWS('Step'), 'Step'[step_status] = "FAILED") + 0
			VAR _Running = CALCULATE(COUNTROWS('Step'), 'Step'[step_status] = "RUNNING") + 0
			
			VAR _FailText = IF(_Failed > 0, " | 🔴 " & _Failed & " Failed", " | 0 Failed")
			VAR _RunningText = IF(_Running > 0, " | 🔵 " & _Running & " Running", "")
			
			RETURN
			    "🟢 " & _Success & " Success | 🟡 " & _Partial & " Partial" & _FailText & _RunningText
		displayFolder: 06. Card Subtexts
		lineageTag: b28b7108-8125-4f73-8225-8da2283407f4

