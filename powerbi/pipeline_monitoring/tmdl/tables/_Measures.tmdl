	/// Total actionable data quality defects formatted as exact integer (e.g. 1,852) so Card visual does not abbreviate to K
	measure 'True Data Defects' = ```
			
			    CALCULATE(
			        COUNTROWS('Error'),
			        'Error'[error_type] <> "EXCLUDED_ORDER_CANCELLED"
			    ) + 0
			```
		formatString: #,0
