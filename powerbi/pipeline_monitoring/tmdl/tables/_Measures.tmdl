	/// Dynamic secondary context for Process Stages card showing the heaviest process stage alias, its share of total runtime, and duration
	measure 'Process Stages Subtext' = ```
			VAR _StageCount = DISTINCTCOUNT('Step'[process_name])
			VAR _TotalContextSec = CALCULATE(SUM('Step'[duration_seconds]), REMOVEFILTERS('Step'[process_name], 'Step'[step_name]))
			VAR _TopStageTable = 
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            VALUES('Step'[process_name]),
			            "@StageSec", CALCULATE(SUM('Step'[duration_seconds])),
			            "@StageRows", CALCULATE(SUM('Step'[rows_processed]))
			        ),
			        [@StageSec], DESC,
			        [@StageRows], DESC
			    )
			VAR _TopStageRaw = MAXX(_TopStageTable, 'Step'[process_name])
			VAR _TopStageSec = COALESCE(MAXX(_TopStageTable, [@StageSec]), 0)
			VAR _Share = DIVIDE(_TopStageSec, _TotalContextSec, 0)
			VAR _TopStageAlias = 
			    SWITCH(
			        _TopStageRaw,
			        "STG_TO_RAW", "STG→RAW",
			        "RAW_TO_ODS", "RAW→ODS",
			        "ODS_TO_DWH", "ODS→DWH",
			        "DWH_MAINTENANCE", "Maintenance",
			        "DWH_RECONCILIATION", "Reconcile",
			        "DWH_DIM_ENRICHMENT", "Enrichment",
			        _TopStageRaw
			    )
			VAR _SecFormatted = 
			    IF(
			        _TopStageSec < 60,
			        FORMAT(_TopStageSec, "#,##0") & "s",
			        FORMAT(INT(_TopStageSec / 60), "#,##0") & "m " & FORMAT(MOD(_TopStageSec, 60), "00") & "s"
			    )
			VAR _Icon = 
			    SWITCH(
			        TRUE(),
			        _StageCount = 0 || _TotalContextSec = 0, "⚪",
			        _Share > 0.50, "🔴",
			        _Share >= 0.35, "🟡",
			        "🟢"
			    )
			VAR _Prefix = IF(_StageCount = 1, "Stage: ", "Heaviest: ")
			RETURN
			    IF(
			        _StageCount = 0,
			        "⚪ No Data",
			        _Prefix & _TopStageAlias & " | " & _Icon & " " & FORMAT(_Share, "0.0%") & " (" & _SecFormatted & ")"
			    )
			```
		displayFolder: 06. Card Subtexts
		lineageTag: 805d59a8-48e1-42e6-8d20-06216b14d2db

	/// Dynamic secondary context for Quarantined Errors card on Data Quality page showing distinct rejected physical rows and multi-fault violations
	measure 'Error Drilldown Subtext' = ```
			VAR _TotalErrors = [Total Quarantined Errors]
			VAR _RejectedRows = 
			    COUNTROWS(
			        SUMMARIZE(
			            'Error',
			            'Error'[batch_id],
			            'Error'[table_name],
			            'Error'[source_file_name],
			            'Error'[source_row_number]
			        )
			    ) + 0
			VAR _MultiFault = MAX(0, _TotalErrors - _RejectedRows)
			RETURN
			    "Rejected Rows: " & FORMAT(_RejectedRows, "#,##0") & " | Multi-fault: " & FORMAT(_MultiFault, "#,##0")
			```
		displayFolder: 06. Card Subtexts
		lineageTag: 35e2cb4a-f2e1-4695-a9c4-61f96e0211cd

	/// Formatted count of distinct source CSV files containing errors (e.g. 36 Files) for Card 2 callout on Data Quality page
	measure 'Affected Files Label' =
			VAR _Files = DISTINCTCOUNT('Error'[source_file_name])
			RETURN
			    IF(
			        _Files = 1,
			        "1 File",
			        FORMAT(_Files, "#,##0") & " Files"
			    )
