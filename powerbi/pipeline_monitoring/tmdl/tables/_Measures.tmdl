	/// Dynamic secondary context for Violated Columns card showing count of triggered DQ rules and error categories
	measure 'Violated Columns Subtext' =
			VAR _TotalErrors = [Total Quarantined Errors]
			VAR _Rules = DISTINCTCOUNT('Error'[error_type]) + 0
			VAR _Categories = DISTINCTCOUNT('Error'[error_category]) + 0
			RETURN
			    IF(
