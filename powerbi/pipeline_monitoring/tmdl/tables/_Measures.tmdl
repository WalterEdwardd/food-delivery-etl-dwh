	/// Percentage of ODS staged records flagged with operational warnings across batches
	measure 'Operational Warning Rate Pct' = ```
			VAR _Warnings = [Total Operational Warnings]
			VAR _OdsRows = 
			    IF(
			        ISFILTERED('Warning'[batch_id]) && NOT ISFILTERED('Batch'[batch_id]),
			        CALCULATE(
			            [Total Records Staged ODS],
			            TREATAS(VALUES('Warning'[batch_id]), 'Reconciliation'[batch_id])
			        ),
			        [Total Records Staged ODS]
			    )
			RETURN
			    DIVIDE(_Warnings, _OdsRows, 0)
			```
		formatString: 0.00%
		displayFolder: 03. Data Quality & Errors
