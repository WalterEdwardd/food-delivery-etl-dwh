	/// Dynamic secondary context for Latest Batch card showing Status and execution context details
	measure 'Latest Batch Subtext' = ```
			VAR _SelectedBatch = SELECTEDVALUE('Batch'[batch_id])
			VAR _BatchID = IF(ISBLANK(_SelectedBatch), [Latest Batch ID], _SelectedBatch)
			VAR _Status = 
			    CALCULATE(
			        SELECTEDVALUE('Batch'[batch_status]),
			        FILTER(ALL('Batch'), 'Batch'[batch_id] = _BatchID)
			    )
			VAR _DurationSec = 
			    CALCULATE(
			        MAX('Batch'[duration_seconds]), 
			        FILTER(ALL('Batch'), 'Batch'[batch_id] = _BatchID)
			    )
			VAR _ErrorRecords = 
			    CALCULATE(
			        MAX('Batch'[error_records]), 
			        FILTER(ALL('Batch'), 'Batch'[batch_id] = _BatchID)
			    )
			VAR _DurationFormatted = 
			    IF(
			        ISBLANK(_DurationSec),
			        "0s",
			        IF(
			            _DurationSec < 60,
			            FORMAT(_DurationSec, "#,##0") & "s",
			            FORMAT(INT(_DurationSec / 60), "#,##0") & "m " & FORMAT(MOD(_DurationSec, 60), "00") & "s"
			        )
			    )
			VAR _StatusDetail = 
			    SWITCH(
			        _Status,
			        "SUCCESS", "Status: 🟢 SUCCESS | Runtime: " & _DurationFormatted,
			        "PARTIAL", "Status: 🟡 PARTIAL | Rejected: " & FORMAT(_ErrorRecords, "#,##0") & " rows",
			        "FAILED",  "Status: 🔴 FAILED | Critical error",
			        "RUNNING", "Status: 🔵 RUNNING | Elapsed: " & _DurationFormatted,
			        "Status: ⚪ No Data"
			    )
			RETURN
			    _StatusDetail
			```
		displayFolder: 06. Card Subtexts
		lineageTag: 3c7b7119-b446-474b-a355-2f9e0af61ef1

