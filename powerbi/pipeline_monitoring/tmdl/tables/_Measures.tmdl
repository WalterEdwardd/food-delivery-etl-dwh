	/// Formatted count of entity reconciliation checks (e.g. 72 Checks) for Card 1 callout on Layer Reconciliation page
	measure 'Reconciliation Checks Label' =
			VAR _Checks = COUNTROWS('Reconciliation') + 0
			RETURN
			    IF(
			        _Checks = 1,
			        "1 Check",
			        FORMAT(_Checks, "#,##0") & " Checks"
