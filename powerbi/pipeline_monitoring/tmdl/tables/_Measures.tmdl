	/// Dynamic secondary context for Affected Source Files card showing total ingested files and affected tables out of total tables dynamically counted from Reconciliation
	measure 'Affected Files Subtext' = ```
			
			VAR _TotalFiles = COALESCE(SUM('Batch'[source_file_count]), 0)
			VAR _AffectedTables = DISTINCTCOUNT('Error'[table_name]) + 0
			VAR _TotalTables = 
			    CALCULATE(
			        DISTINCTCOUNT('Reconciliation'[entity_name]),
			        ALL('Reconciliation')
			        )
			RETURN
			    "Total Files: " & FORMAT(_TotalFiles, "#,##0") & " | Tables: " & _AffectedTables & "/" & _TotalTables & " Affected"
			```
		displayFolder: 06. Card Subtexts
		lineageTag: 7a2a3b02-4ac2-406c-87e5-bc8cc23af8ae

	/// Formatted count of distinct columns encountering data quality errors (e.g. 12 Columns) for Card 4 callout on Data Quality page
	measure 'Violated Columns Label' =
			VAR _Cols = DISTINCTCOUNT('Error'[column_name])
			RETURN
