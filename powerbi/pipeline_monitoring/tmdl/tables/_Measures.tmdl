	/// Percentage of RAW ingested records quarantined due to data quality violations across batches
	measure 'Quarantined Error Rate Pct' = ```
			VAR _Errors = [Total Quarantined Errors]
			VAR _RawRows = 
			    IF(
			        ISFILTERED('Error'[batch_id]) && NOT ISFILTERED('Batch'[batch_id]),
			        CALCULATE(
			            [Total Records Ingested RAW],
			            TREATAS(VALUES('Error'[batch_id]), 'Reconciliation'[batch_id])
			        ),
			        [Total Records Ingested RAW]
			    )
			RETURN
			    DIVIDE(_Errors, _RawRows, 0)
			```
		formatString: 0.00%
		displayFolder: 03. Data Quality & Errors
		lineageTag: c73ab040-651d-4788-8002-e2dad2a7ad08

	/// Total row count discrepancy between ODS and DWH layers (negative indicates SCD2 historical version expansion in DWH)
	measure 'Total ODS to DWH Variance' = COALESCE(SUM('Reconciliation'[ods_to_dwh_variance]), 0)
