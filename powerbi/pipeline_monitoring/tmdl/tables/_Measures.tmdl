	/// Dynamic secondary context for Reconciliation Checks card showing exact matches and SCD variance count
	measure 'Reconciliation Checks Subtext' =
			VAR _Total = COUNTROWS('Reconciliation') + 0
			VAR _Exact = CALCULATE(COUNTROWS('Reconciliation'), 'Reconciliation'[audit_status] = "RECONCILED (Valid Audit)") + 0
			VAR _Variance = CALCULATE(COUNTROWS('Reconciliation'), 'Reconciliation'[audit_status] <> "RECONCILED (Valid Audit)") + 0
			RETURN
			    IF(
			        _Total = 0,
			        "⚪ No Data",
			        "🟢 " & FORMAT(_Exact, "#,##0") & " Exact Match | 🟡 " & FORMAT(_Variance, "#,##0") & " SCD Variances"
			    )
		displayFolder: 06. Card Subtexts
		lineageTag: 9047045a-a07c-4cca-9bbd-dceb0c078ada

	/// Dynamic secondary context for ODS Staged Volume card showing total RAW volume and deduplicated rows in ODS
	measure 'ODS Staged Subtext' =
			VAR _Raw = [Total Records Ingested RAW] + 0
			VAR _RawToOdsDiff = [Total RAW to ODS Variance]
			VAR _Errors = [Total Reconciliation Errors]
			VAR _Deduped = MAX(0, _RawToOdsDiff - _Errors)
			RETURN
			    IF(
			        _Raw = 0,
			        "⚪ No Data",
			        "RAW: " & FORMAT(_Raw, "#,##0") & " | Deduped: " & FORMAT(_Deduped, "#,##0") & " rows"
			    )
		displayFolder: 06. Card Subtexts
		lineageTag: b795c92e-b26e-430b-a1bf-f6bc212c9d68

	/// Dynamic secondary context for DWH Loaded Volume card showing SCD2 historical version rows added and unaccounted data loss check
	measure 'DWH Loaded Subtext' =
			VAR _Dwh = [Total Records Loaded DWH] + 0
			VAR _OdsToDwhVar = [Total ODS to DWH Variance]
			VAR _Scd2Added = MAX(0, -_OdsToDwhVar)
			VAR _UnaccountedLoss = SUMX('Reconciliation', MAX(0, 'Reconciliation'[ods_to_dwh_variance])) + 0
			VAR _LossText = IF(_UnaccountedLoss = 0, "🟢 0", "🔴 " & FORMAT(_UnaccountedLoss, "#,##0"))
			VAR _ScdPrefix = IF(_Scd2Added > 0, "+", "")
			RETURN
			    IF(
			        _Dwh = 0,
			        "⚪ No Data",
			        "SCD2 Versions: " & _ScdPrefix & FORMAT(_Scd2Added, "#,##0") & " | Unaccounted: " & _LossText
			    )
		displayFolder: 06. Card Subtexts
		lineageTag: 0aa722dd-91a3-49ae-96b5-08d3e5313bf7

	/// Dynamic secondary context for Data Retention Rate card showing retention health status and net row difference from RAW to DWH
	measure 'Retention Rate Subtext' = ```
			VAR _Raw = [Total Records Ingested RAW] + 0
			VAR _Dwh = [Total Records Loaded DWH] + 0
			VAR _Rate = [Overall Data Retention Rate Pct]
			VAR _NetDiff = _Dwh - _Raw
			VAR _DiffSign = IF(_NetDiff > 0, "+", "")
			VAR _Status = 
			    SWITCH(
			        TRUE(),
			        _Raw = 0, "⚪ No Data",
			        _Rate >= 0.98, "🟢 Healthy (>= 98%)",
			        _Rate >= 0.95, "🟡 Moderate (95% - 98%)",
			        "🔴 Low (< 95%)"
			    )
			RETURN
			    IF(
			        _Raw = 0,
			        "⚪ No Data",
			        _Status & " | Net Diff: " & _DiffSign & FORMAT(_NetDiff, "#,##0")
			    )
			```
		displayFolder: 06. Card Subtexts
		lineageTag: 31ac0e32-c35c-4d45-b5d7-af3dd1b42137

	/// Dynamic secondary context for SCD2 Audit Changes card showing unique business keys, affected dimensions, and tracked attributes
	measure 'Dimension Changes Subtext' =
			VAR _Changes = [Total Dimension Changes] + 0
			VAR _Keys = DISTINCTCOUNT('Audit'[business_id]) + 0
			VAR _Dims = DISTINCTCOUNT('Audit'[dimension_name]) + 0
			VAR _Attrs = DISTINCTCOUNT('Audit'[column_name]) + 0
			RETURN
			    IF(
			        _Changes = 0,
			        "⚪ No SCD2 Changes",
			        "Unique Keys: " & FORMAT(_Keys, "#,##0") & " | Dims: " & _Dims & " | Attrs: " & _Attrs
			    )
		displayFolder: 06. Card Subtexts
		lineageTag: 82f5f1f8-9c35-4577-8b40-b4030e16e765

