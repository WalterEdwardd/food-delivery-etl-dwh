	/// Dynamic secondary context for Execution Duration card comparing current batch throughput to system median throughput with single colored circle icon after colon
	measure 'Batch Duration Subtext' = ```
			
			VAR _SelectedBatch = SELECTEDVALUE('Batch'[batch_id])
			VAR _BatchID = IF(ISBLANK(_SelectedBatch), [Latest Batch ID], _SelectedBatch)
			VAR _DurationSec = CALCULATE(MAX('Batch'[duration_seconds]), FILTER(ALL('Batch'), 'Batch'[batch_id] = _BatchID))
			VAR _Records = CALCULATE(MAX('Batch'[total_records]), FILTER(ALL('Batch'), 'Batch'[batch_id] = _BatchID))
			VAR _Throughput = DIVIDE(_Records, _DurationSec, 0)
			VAR _MedianThroughput = MEDIANX(ALL('Batch'), DIVIDE('Batch'[total_records], 'Batch'[duration_seconds], 0))
			
			VAR _ThroughputFormatted = 
			    IF(
			        _Throughput >= 1000, 
			        FORMAT(_Throughput / 1000, "0.0") & "k rows/s", 
			        FORMAT(_Throughput, "#,##0") & " rows/s"
			    )
			VAR _MedianFormatted = 
			    IF(
			        _MedianThroughput >= 1000, 
			        FORMAT(_MedianThroughput / 1000, "0.0") & "k", 
			        FORMAT(_MedianThroughput, "#,##0")
			    )
			
			VAR _CompIcon = 
			    SWITCH(
			        TRUE(),
			        _Throughput > _MedianThroughput * 1.05, "🟢",
			        _Throughput < _MedianThroughput * 0.95, "🟡",
			        "⚪"
			    )
			RETURN
			    "Throughput: " & _CompIcon & " " & _ThroughputFormatted & " | Median: " & _MedianFormatted
			```
		displayFolder: 06. Card Subtexts
		lineageTag: 2fb0530a-5cc1-4e78-9ed1-30f053417f12

