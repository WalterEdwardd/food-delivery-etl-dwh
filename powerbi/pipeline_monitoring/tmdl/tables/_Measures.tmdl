	/// Dynamic secondary context for True Data Defects card showing defect impact share and count of cancelled orders
	measure 'Data Defects Subtext' = ```
			VAR _TotalErrors = [Total Quarantined Errors]
			VAR _Defects = 
			    CALCULATE(
			        COUNTROWS('Error'),
			        'Error'[error_type] <> "EXCLUDED_ORDER_CANCELLED"
			    ) + 0
			VAR _Cancelled = CALCULATE(COUNTROWS('Error'), 'Error'[error_type] = "EXCLUDED_ORDER_CANCELLED") + 0
			VAR _Impact = DIVIDE(_Defects, _TotalErrors, 0)
			RETURN
			    IF(
			        _TotalErrors = 0,
			        "⚪ No Errors",
			        "Impact: " & FORMAT(_Impact, "0.0%") & " | Cancelled Orders: " & FORMAT(_Cancelled, "#,##0")
			    )
			```
		displayFolder: 06. Card Subtexts
		lineageTag: f6fa25c5-df12-447f-b86e-e7cc87df690a

	/// Dynamic secondary context for Operational Warnings card on Data Quality page showing affected tables out of total tables and distinct warning types
	measure 'Warning Drilldown Subtext' =
			VAR _Warnings = [Total Operational Warnings] + 0
			VAR _AffectedTables = DISTINCTCOUNT('Warning'[table_name]) + 0
			VAR _TotalTables = CALCULATE(DISTINCTCOUNT('Reconciliation'[entity_name]), ALL('Reconciliation'))
			VAR _WarningTypes = DISTINCTCOUNT('Warning'[warning_type]) + 0
			RETURN
			    IF(
			        _Warnings = 0,
			        "⚪ No Warnings",
			        "Tables: " & _AffectedTables & "/" & _TotalTables & " Affected | Warning Types: " & FORMAT(_WarningTypes, "#,##0")
			    )
