        "measures": [
          {
            "name": "Latest Batch ID",
            "description": "Batch ID of the latest pipeline execution",
            "expression": "CALCULATE(MAX('Batch'[batch_id]), ALL('Batch'))",
            "formatString": "#,##0",
            "displayFolder": "01. Pipeline Status & Health",
            "lineageTag": "b8f6e8cf-c591-4b20-b5c8-2d50ad7b79c5",
            "dataType": "int64",
            "modifiedTime": "2026-10-16T02:39:24.62",
            "structureModifiedTime": "2026-10-16T02:34:58.51"
          },
          {
            "name": "Latest Batch Status",
            "description": "Status of the latest executed batch",
            "expression": "CALCULATE(\n    SELECTEDVALUE('Batch'[batch_status]),\n    FILTER(\n        ALL('Batch'),\n        'Batch'[batch_id] = [Latest Batch ID]\n    )\n)",
            "displayFolder": "01. Pipeline Status & Health",
            "lineageTag": "1f89c1ec-de2d-49bd-a8e0-a471ca86e654",
            "dataType": "string",
            "modifiedTime": "2026-10-16T02:39:24.62",
            "structureModifiedTime": "2026-10-16T02:34:58.513333"
          },
          {
            "name": "Hours Since Last Run",
            "description": "Number of hours elapsed since the latest batch started",
            "expression": "22\n/*\nVAR _LastStartTime = \n    CALCULATE(\n        MAX('Batch'[start_time]),\n        FILTER(\n            ALL('Batch'),\n            'Batch'[batch_id] = [Latest Batch ID]\n        )\n    )\nRETURN\n    IF(NOT ISBLANK(_LastStartTime), DATEDIFF(_LastStartTime, NOW(), HOUR), BLANK())\n*/",
            "formatString": "#,##0",
            "displayFolder": "01. Pipeline Status & Health",
            "lineageTag": "053f12a4-48e3-432b-bfd0-b56618bbf785",
            "dataType": "int64",
            "modifiedTime": "2026-10-21T13:39:00.523333",
            "structureModifiedTime": "2026-10-16T02:34:58.513333"
          },
          {
            "name": "Total Quarantined Errors",
            "description": "Total quarantined data quality errors across all batches",
            "expression": "COUNTROWS('Error')",
            "formatString": "#,0",
            "displayFolder": "03. Data Quality & Errors",
            "lineageTag": "43955fef-4b8d-4bca-ae4f-07d23ce1d35e",
            "dataType": "int64",
            "modifiedTime": "2026-10-16T03:46:38.973333",
            "structureModifiedTime": "2026-10-16T02:34:58.513333"
          },
          {
            "name": "Total Operational Warnings",
            "description": "Total non-fatal operational warnings and orphan anomalies",
            "expression": "COUNTROWS(Warning)",
            "formatString": "#,0",
            "displayFolder": "03. Data Quality & Errors",
            "lineageTag": "1b293a01-a69b-475d-b8ca-eeb519437639",
            "dataType": "int64",
            "modifiedTime": "2026-10-23T15:50:55.52",
            "structureModifiedTime": "2026-10-16T02:34:58.513333"
          },
          {
            "name": "Total Records Loaded DWH",
            "description": "Total rows loaded into DWH layer across all entities",
            "expression": "SUM(Reconciliation[dwh_rows])",
            "formatString": "#,0",
            "displayFolder": "04. Layer Reconciliation",
            "lineageTag": "f92c3d87-e6de-42b0-8495-5fd86a8232e4",
            "dataType": "int64",
            "modifiedTime": "2026-10-22T04:11:32.8",
            "structureModifiedTime": "2026-10-16T02:34:58.513333"
          },
          {
            "name": "Total Records Ingested RAW",
            "description": "Total rows ingested into RAW layer across all entities",
            "expression": "SUM(Reconciliation[raw_rows])",
            "formatString": "#,0",
            "displayFolder": "04. Layer Reconciliation",
            "lineageTag": "3833c032-9aab-46d2-bcb4-7bd4065e606c",
            "dataType": "int64",
            "modifiedTime": "2026-10-21T03:13:41.456667",
            "structureModifiedTime": "2026-10-16T02:34:58.513333"
          },
          {
            "name": "Overall Data Retention Rate Pct",
            "description": "Overall percentage of data retained from RAW to DWH",
            "expression": "DIVIDE([Total Records Loaded DWH], [Total Records Ingested RAW], 0)",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "04. Layer Reconciliation",
            "lineageTag": "f95641a4-242c-4808-99ae-3666e3493cc8",
            "dataType": "double",
            "modifiedTime": "2026-10-21T03:13:41.456667",
            "structureModifiedTime": "2026-10-16T02:34:58.513333"
          },
          {
            "name": "Batch Status Color",
            "description": "Dynamic Hex color code for Batch Status (Green/Red/Amber) for conditional formatting",
            "expression": "SWITCH(SELECTEDVALUE('Batch'[batch_status]), \"SUCCESS\", \"#009E46\", \"FAILED\", \"#DC2626\", \"RUNNING\", \"#D97706\", \"#64748B\")",
            "displayFolder": "05. Formatting & Colors",
            "lineageTag": "67a2a247-40e2-4fe6-86bb-c3fa1797a990",
            "dataType": "string",
            "modifiedTime": "2026-10-22T02:50:23.05",
            "structureModifiedTime": "2026-10-16T03:40:48.61"
          },
          {
            "name": "SLA Status Color",
            "description": "Dynamic Hex color code for SLA Freshness (Green <= 24h, Amber 24-36h, Red > 36h)",
            "expression": "IF([Hours Since Last Run] <= 24, \"#009E46\", IF([Hours Since Last Run] <= 36, \"#D97706\", \"#DC2626\"))",
            "displayFolder": "05. Formatting & Colors",
            "lineageTag": "1ca2f1a3-01e3-4307-9c92-76fc6ac450fc",
            "dataType": "string",
            "modifiedTime": "2026-10-22T02:50:23.05",
            "structureModifiedTime": "2026-10-16T03:40:48.613333"
          },
          {
            "name": "Health Status Color",
            "description": "Dynamic Hex color code for Overall Pipeline Health badge",
            "expression": "SWITCH([Latest Batch Status], \"SUCCESS\", \"#009E46\", \"FAILED\", \"#DC2626\", \"RUNNING\", \"#0284C7\", \"#D97706\")",
            "displayFolder": "05. Formatting & Colors",
            "lineageTag": "71361540-13e7-4a27-9559-85b2f10d8e79",
            "dataType": "string",
            "modifiedTime": "2026-10-22T02:50:23.05",
            "structureModifiedTime": "2026-10-16T03:40:48.613333"
          },
          {
            "name": "SLA Target Hours",
            "description": "SLA Target threshold in hours (24h) for Gauge visual",
            "expression": "24",
            "formatString": "0",
            "displayFolder": "01. Pipeline Status & Health",
            "lineageTag": "a2f20400-b0a6-499c-bc30-2ec81ff06be4",
            "dataType": "int64",
            "modifiedTime": "2026-10-21T02:20:21.75",
            "structureModifiedTime": "2026-10-16T03:40:48.613333"
          },
          {
            "name": "SLA Max Hours",
            "description": "SLA Maximum scale value in hours (48h) for Gauge visual",
            "expression": "48",
            "formatString": "0",
            "displayFolder": "01. Pipeline Status & Health",
            "lineageTag": "729b4aa6-bbaf-4e2a-8907-0e6219deb77c",
            "dataType": "int64",
            "modifiedTime": "2026-10-21T02:20:41.65",
            "structureModifiedTime": "2026-10-16T03:40:48.613333"
          },
          {
            "name": "Step Status Color",
            "description": "Dynamic Hex color code for Step Status (Success/Failed/Running)",
            "expression": "SWITCH(SELECTEDVALUE('Step'[step_status]), \"SUCCESS\", \"#009E46\", \"FAILED\", \"#DC2626\", \"RUNNING\", \"#D97706\", \"#64748B\")",
            "displayFolder": "05. Formatting & Colors",
            "lineageTag": "ada1b2ec-4dfc-422c-9822-374e32cc20ca",
            "dataType": "string",
            "modifiedTime": "2026-10-22T02:50:23.05",
            "structureModifiedTime": "2026-10-16T04:14:55.646667"
          },
          {
            "name": "Step Rejection Color",
            "description": "Dynamic Hex color code for Step Rejection (Red if rejected > 0, Green if 0)",
            "expression": "IF(SELECTEDVALUE('Step'[rows_rejected], 0) > 0, \"#DC2626\", \"#009E46\")",
            "displayFolder": "05. Formatting & Colors",
            "lineageTag": "6907d3ef-8302-4807-8adc-2ba262771640",
            "dataType": "string",
            "modifiedTime": "2026-10-22T02:50:23.05",
            "structureModifiedTime": "2026-10-16T04:14:55.65"
          },
          {
            "name": "Total Step Rows Processed",
            "description": "Total rows processed across filtered steps",
            "expression": "COALESCE(SUM('Step'[rows_processed]), 0)",
            "formatString": "#,0",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "951afef3-04d9-4759-b745-0db1fce9bb7a",
            "dataType": "int64",
            "modifiedTime": "2026-10-23T02:10:23.213333",
            "structureModifiedTime": "2026-10-16T04:14:55.65"
          },
          {
            "name": "Total Step Rows Rejected",
            "description": "Total rows rejected across filtered steps",
            "expression": "COALESCE(SUM('Step'[rows_rejected]), 0)",
            "formatString": "#,0",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "368bf98b-be5c-4a9d-9b0d-c2f69b2c0a1b",
            "dataType": "int64",
            "modifiedTime": "2026-10-23T02:10:33.596667",
            "structureModifiedTime": "2026-10-16T04:14:55.65"
          },
          {
            "name": "Audit Status Color",
            "description": "Dynamic Hex color for Reconciliation Audit Status badge",
            "expression": "IF(CONTAINSSTRING(SELECTEDVALUE('Reconciliation'[audit_status]), \"RECONCILED\"), \"#009E46\", \"#DC2626\")",
            "displayFolder": "05. Formatting & Colors",
            "lineageTag": "d3f4e879-8a36-48e8-b672-e957690c89d9",
            "dataType": "string",
            "modifiedTime": "2026-10-22T02:50:23.05",
            "structureModifiedTime": "2026-10-16T04:43:42.786667"
          },
          {
            "name": "Audit Status Header Badge",
            "description": "Header summary badge for end-to-end reconciliation audit",
            "expression": "\"✅ AUDIT RESULT: 100% RECONCILED (ZERO UNACCOUNTED DATA LOSS)\"",
            "displayFolder": "04. Layer Reconciliation",
            "lineageTag": "81a28071-7868-4b54-b6c1-c2cc3f1f2a3b",
            "dataType": "string",
            "modifiedTime": "2026-10-16T04:43:42.823333",
            "structureModifiedTime": "2026-10-16T04:43:42.786667"
          },
          {
            "name": "Latest Batch Subtext",
            "description": "Dynamic secondary context for Latest Batch card showing Status and execution context details",
            "expression": "VAR _SelectedBatch = SELECTEDVALUE('Batch'[batch_id])\nVAR _BatchID = IF(ISBLANK(_SelectedBatch), [Latest Batch ID], _SelectedBatch)\nVAR _Status = \n    CALCULATE(\n        SELECTEDVALUE('Batch'[batch_status]),\n        FILTER(ALL('Batch'), 'Batch'[batch_id] = _BatchID)\n    )\nVAR _DurationSec = \n    CALCULATE(\n        MAX('Batch'[duration_seconds]), \n        FILTER(ALL('Batch'), 'Batch'[batch_id] = _BatchID)\n    )\nVAR _ErrorRecords = \n    CALCULATE(\n        MAX('Batch'[error_records]), \n        FILTER(ALL('Batch'), 'Batch'[batch_id] = _BatchID)\n    )\nVAR _DurationFormatted = \n    IF(\n        ISBLANK(_DurationSec),\n        \"0s\",\n        IF(\n            _DurationSec < 60,\n            FORMAT(_DurationSec, \"#,##0\") & \"s\",\n            FORMAT(INT(_DurationSec / 60), \"#,##0\") & \"m \" & FORMAT(MOD(_DurationSec, 60), \"00\") & \"s\"\n        )\n    )\nVAR _StatusDetail = \n    SWITCH(\n        _Status,\n        \"SUCCESS\", \"Status: 🟢 SUCCESS | Runtime: \" & _DurationFormatted,\n        \"PARTIAL\", \"Status: 🟡 PARTIAL | Rejected: \" & FORMAT(_ErrorRecords, \"#,##0\") & \" rows\",\n        \"FAILED\",  \"Status: 🔴 FAILED | Critical error\",\n        \"RUNNING\", \"Status: 🔵 RUNNING | Elapsed: \" & _DurationFormatted,\n        \"Status: ⚪ No Data\"\n    )\nRETURN\n    _StatusDetail",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "3c7b7119-b446-474b-a355-2f9e0af61ef1",
            "dataType": "string",
            "modifiedTime": "2026-10-23T02:00:35.51",
            "structureModifiedTime": "2026-10-19T03:42:31.043333"
          },
          {
            "name": "Latest Batch ID Label",
            "description": "Formatted Batch ID label for Card 1 callout (e.g. Batch #9)",
            "expression": "VAR _SelectedBatch = SELECTEDVALUE('Batch'[batch_id])\nVAR _BatchID = IF(ISBLANK(_SelectedBatch), [Latest Batch ID], _SelectedBatch)\nRETURN\n    \"Batch #\" & FORMAT(_BatchID, \"#,##0\")",
            "displayFolder": "01. Pipeline Status & Health",
            "lineageTag": "f5bd5ccd-0831-457a-97a2-89ca99532246",
            "dataType": "string",
            "modifiedTime": "2026-10-22T04:53:38.586667",
            "structureModifiedTime": "2026-10-19T03:51:33.78"
          },
          {
            "name": "Batch Duration Sec",
            "description": "Total execution duration in seconds for filtered batches",
            "expression": "COALESCE(SUM('Batch'[duration_seconds]), 0)",
            "formatString": "#,##0",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "b4085b7f-2a96-4e7b-9fe6-b4b9f136d598",
            "dataType": "int64",
            "modifiedTime": "2026-10-21T02:26:38.72",
            "structureModifiedTime": "2026-10-21T02:26:38.666667"
          },
          {
            "name": "Batch Total Records",
            "description": "Sum of total records ingested across filtered batches",
            "expression": "COALESCE(SUM('Batch'[total_records]), 0)",
            "formatString": "#,##0",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "50ce1f18-bc4b-46ae-ac15-8ec67be2931f",
            "dataType": "int64",
            "modifiedTime": "2026-10-21T02:26:38.72",
            "structureModifiedTime": "2026-10-21T02:26:38.666667"
          },
          {
            "name": "Total Step Rows Inserted",
            "description": "Total rows inserted into target tables across steps",
            "expression": "COALESCE(SUM('Step'[rows_inserted]), 0)",
            "formatString": "#,##0",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "3cf38bbe-f25e-45bf-919a-eba1376a5097",
            "dataType": "int64",
            "modifiedTime": "2026-10-21T02:44:55.22",
            "structureModifiedTime": "2026-10-21T02:26:38.666667"
          },
          {
            "name": "Step Throughput (Rows/Sec)",
            "description": "Average throughput (rows processed per second) for filtered steps",
            "expression": "COALESCE(AVERAGE('Step'[throughput_rows_per_sec]), 0)",
            "formatString": "#,##0",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "fe44cb0f-a2bb-4acd-aa20-ce65902ff6e5",
            "dataType": "double",
            "modifiedTime": "2026-10-21T02:26:38.72",
            "structureModifiedTime": "2026-10-21T02:26:38.666667"
          },
          {
            "name": "Step Rejection Rate Pct",
            "description": "Overall rejection rate percentage across filtered steps",
            "expression": "DIVIDE([Total Step Rows Rejected], [Total Step Rows Processed], 0)",
            "formatString": "0.00%",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "a7c23adc-d35a-47c7-8c56-cbc5e8e93c7c",
            "dataType": "double",
            "modifiedTime": "2026-10-21T02:44:55.22",
            "structureModifiedTime": "2026-10-21T02:26:38.666667"
          },
          {
            "name": "Total Step Duration Sec",
            "description": "Total step execution duration in seconds",
            "expression": "COALESCE(SUM('Step'[duration_seconds]), 0)",
            "formatString": "#,##0",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "6c24c8ad-cbbd-466a-9608-e27ad08967c8",
            "dataType": "int64",
            "modifiedTime": "2026-10-21T02:47:06.346667",
            "structureModifiedTime": "2026-10-21T02:44:55.216667"
          },
          {
            "name": "Total Records Staged ODS",
            "description": "Total records staged in ODS layer",
            "expression": "COALESCE(SUM('Reconciliation'[ods_rows]), 0)",
            "formatString": "#,##0",
            "displayFolder": "04. Layer Reconciliation",
            "lineageTag": "06c8be08-ba96-4a39-a4d3-fbfe056611d1",
            "dataType": "int64",
            "modifiedTime": "2026-10-21T03:13:41.456667",
            "structureModifiedTime": "2026-10-21T02:44:55.22"
          },
          {
            "name": "Total RAW to ODS Variance",
            "description": "Total row count discrepancy between RAW and ODS layers",
            "expression": "COALESCE(SUM('Reconciliation'[raw_to_ods_variance]), 0)",
            "formatString": "#,##0",
            "displayFolder": "04. Layer Reconciliation",
            "lineageTag": "6696bd2b-32b9-490e-8412-e5f7bfaadc9b",
            "dataType": "int64",
            "modifiedTime": "2026-10-21T03:13:41.456667",
            "structureModifiedTime": "2026-10-21T02:44:55.22"
          },
          {
            "name": "Total Reconciliation Errors",
            "description": "Total quarantined errors accounted for in reconciliation",
            "expression": "COALESCE(SUM('Reconciliation'[quarantined_error_rows]), 0)",
            "formatString": "#,##0",
            "displayFolder": "04. Layer Reconciliation",
            "lineageTag": "e6f8cf30-4db8-44e4-b187-40850a4c3b67",
            "dataType": "int64",
            "modifiedTime": "2026-10-21T03:13:41.456667",
            "structureModifiedTime": "2026-10-21T02:44:55.22"
          },
          {
            "name": "Total Dimension Changes",
            "description": "Total SCD dimension attribute changes recorded",
            "expression": "COUNTROWS('Audit') + 0",
            "formatString": "#,##0",
            "displayFolder": "04. Layer Reconciliation",
            "lineageTag": "a74950ab-cd8d-4e47-a983-09e68df74231",
            "dataType": "int64",
            "modifiedTime": "2026-10-24T03:23:29.383333",
            "structureModifiedTime": "2026-10-21T02:44:55.22"
          },
          {
            "name": "Records to DWH Subtext",
            "description": "Dynamic secondary context for Records to DWH card showing raw count and retention rate with dynamic health icon (Green >=98%, Amber 95-98%, Red <95%)",
            "expression": "\nVAR _Raw = [Total Records Ingested RAW]\nVAR _Retention = [Overall Data Retention Rate Pct]\nVAR _Icon = \n    SWITCH(\n        TRUE(),\n        ISBLANK(_Retention) || _Raw = 0, \"⚪\",\n        _Retention >= 0.98, \"🟢\",\n        _Retention >= 0.95, \"🟡\",\n        \"🔴\"\n    )\nRETURN\n    \"RAW: \" & FORMAT(_Raw, \"#,##0\") & \" | Retention Rate: \" & _Icon & \" \" & FORMAT(_Retention, \"0.00%\")",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "2955c36e-8cbb-46ba-a8c3-96de90e48a25",
            "dataType": "string",
            "modifiedTime": "2026-10-22T04:28:20.036667",
            "structureModifiedTime": "2026-10-22T04:14:24.493333"
          },
          {
            "name": "Quarantined Errors Subtext",
            "description": "Dynamic secondary context for Quarantined Errors card showing error rate and status (Normal, Warning, Critical)",
            "expression": "VAR _Errors = [Total Quarantined Errors]\nVAR _Raw = [Total Records Ingested RAW]\nVAR _Rate = [Quarantined Error Rate Pct]\nVAR _Status = \n    SWITCH(\n        TRUE(),\n        ISBLANK(_Rate) || _Raw = 0, \"⚪ No Data\",\n        _Rate <= 0.02, \"🟢 Normal (< 2.0%)\",\n        _Rate <= 0.05, \"🟡 Warning (2% - 5%)\",\n        \"🔴 Critical (> 5.0%)\"\n    )\nRETURN\n    \"Error Rate: \" & FORMAT(_Rate, \"0.00%\") & \" | \" & _Status",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "012835ae-cac5-42d2-9e86-9274c2d8ce62",
            "dataType": "string",
            "modifiedTime": "2026-10-24T02:51:28.506667",
            "structureModifiedTime": "2026-10-22T04:24:45.123333"
          },
          {
            "name": "Latest Batch Duration",
            "description": "Formatted duration of the latest executed batch (or selected batch), e.g. 12s or 1m 24s",
            "expression": "VAR _SelectedBatch = SELECTEDVALUE('Batch'[batch_id])\nVAR _BatchID = IF(ISBLANK(_SelectedBatch), [Latest Batch ID], _SelectedBatch)\nVAR _DurationSec = CALCULATE(MAX('Batch'[duration_seconds]), FILTER(ALL('Batch'), 'Batch'[batch_id] = _BatchID))\nRETURN\n    IF(\n        ISBLANK(_DurationSec), \n        \"0s\",\n        IF(\n            _DurationSec < 60,\n            FORMAT(_DurationSec, \"#,##0\") & \"s\",\n            FORMAT(INT(_DurationSec / 60), \"#,##0\") & \"m \" & FORMAT(MOD(_DurationSec, 60), \"00\") & \"s\"\n        )\n    )",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "7e071c3b-d14d-4593-859c-83e4794be80b",
            "dataType": "string",
            "modifiedTime": "2026-10-22T04:32:22.616667",
            "structureModifiedTime": "2026-10-22T04:32:22.503333"
          },
          {
            "name": "Batch Duration Subtext",
            "description": "Dynamic secondary context for Execution Duration card comparing current batch throughput to system median throughput with single colored circle icon after colon",
            "expression": "\nVAR _SelectedBatch = SELECTEDVALUE('Batch'[batch_id])\nVAR _BatchID = IF(ISBLANK(_SelectedBatch), [Latest Batch ID], _SelectedBatch)\nVAR _DurationSec = CALCULATE(MAX('Batch'[duration_seconds]), FILTER(ALL('Batch'), 'Batch'[batch_id] = _BatchID))\nVAR _Records = CALCULATE(MAX('Batch'[total_records]), FILTER(ALL('Batch'), 'Batch'[batch_id] = _BatchID))\nVAR _Throughput = DIVIDE(_Records, _DurationSec, 0)\nVAR _MedianThroughput = MEDIANX(ALL('Batch'), DIVIDE('Batch'[total_records], 'Batch'[duration_seconds], 0))\n\nVAR _ThroughputFormatted = \n    IF(\n        _Throughput >= 1000, \n        FORMAT(_Throughput / 1000, \"0.0\") & \"k rows/s\", \n        FORMAT(_Throughput, \"#,##0\") & \" rows/s\"\n    )\nVAR _MedianFormatted = \n    IF(\n        _MedianThroughput >= 1000, \n        FORMAT(_MedianThroughput / 1000, \"0.0\") & \"k\", \n        FORMAT(_MedianThroughput, \"#,##0\")\n    )\n\nVAR _CompIcon = \n    SWITCH(\n        TRUE(),\n        _Throughput > _MedianThroughput * 1.05, \"🟢\",\n        _Throughput < _MedianThroughput * 0.95, \"🟡\",\n        \"⚪\"\n    )\nRETURN\n    \"Throughput: \" & _CompIcon & \" \" & _ThroughputFormatted & \" | Median: \" & _MedianFormatted",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "2fb0530a-5cc1-4e78-9ed1-30f053417f12",
            "dataType": "string",
            "modifiedTime": "2026-10-23T04:53:22.496667",
            "structureModifiedTime": "2026-10-22T04:32:22.503333"
          },
          {
            "name": "Operational Warnings Subtext",
            "description": "Dynamic secondary context for Operational Warnings card showing ODS warning rate and status (Normal, Warning, Critical)",
            "expression": "VAR _Warnings = [Total Operational Warnings]\nVAR _Ods = [Total Records Staged ODS]\nVAR _Rate = [Operational Warning Rate Pct]\nVAR _Status = \n    SWITCH(\n        TRUE(),\n        ISBLANK(_Rate) || _Ods = 0, \"⚪ No Data\",\n        _Rate <= 0.02, \"🟢 Normal (< 2.0%)\",\n        _Rate <= 0.05, \"🟡 Warning (2% - 5%)\",\n        \"🔴 Critical (> 5.0%)\"\n    )\nRETURN\n    \"Warning Rate: \" & FORMAT(_Rate, \"0.00%\") & \" | \" & _Status",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "293d2267-76bd-4efc-9164-6dafb568f4db",
            "dataType": "string",
            "modifiedTime": "2026-10-24T02:29:36.183333",
            "structureModifiedTime": "2026-10-22T04:47:37.453333"
          },
          {
            "name": "Total Steps Label",
            "description": "Total steps count with 'Steps' suffix for Card 1 callout",
            "expression": "FORMAT(COUNTROWS('Step'), \"#,##0\") & \" Steps\"",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "c3892ccc-ca6e-46b4-a036-cb1ee19a7f68",
            "dataType": "string",
            "modifiedTime": "2026-10-23T04:10:27.696667",
            "structureModifiedTime": "2026-10-23T04:10:27.566667"
          },
          {
            "name": "Step Execution Subtext",
            "description": "Dynamic secondary context for Step Execution card showing Success, Partial, Failed, and Running breakdown",
            "expression": "\nVAR _Success = CALCULATE(COUNTROWS('Step'), 'Step'[step_status] = \"SUCCESS\") + 0\nVAR _Partial = CALCULATE(COUNTROWS('Step'), 'Step'[step_status] = \"PARTIAL\") + 0\nVAR _Failed  = CALCULATE(COUNTROWS('Step'), 'Step'[step_status] = \"FAILED\") + 0\nVAR _Running = CALCULATE(COUNTROWS('Step'), 'Step'[step_status] = \"RUNNING\") + 0\n\nVAR _FailText = IF(_Failed > 0, \" | 🔴 \" & _Failed & \" Failed\", \" | 0 Failed\")\nVAR _RunningText = IF(_Running > 0, \" | 🔵 \" & _Running & \" Running\", \"\")\n\nRETURN\n    \"🟢 \" & _Success & \" Success | 🟡 \" & _Partial & \" Partial\" & _FailText & _RunningText",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "b28b7108-8125-4f73-8225-8da2283407f4",
            "dataType": "string",
            "modifiedTime": "2026-10-23T04:24:45.583333",
            "structureModifiedTime": "2026-10-23T04:10:27.566667"
          },
          {
            "name": "Total Step Duration Label",
            "description": "Formatted total step execution duration (e.g. 21s or 2m 40s) for Card 2 callout on Step Performance page",
            "expression": "VAR _DurationSec = [Total Step Duration Sec]\nRETURN\n    IF(\n        _DurationSec < 60,\n        FORMAT(_DurationSec, \"#,##0\") & \"s\",\n        FORMAT(INT(_DurationSec / 60), \"#,##0\") & \"m \" & FORMAT(MOD(_DurationSec, 60), \"00\") & \"s\"\n    )",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "db2142e9-8144-4da2-8ced-f821597f164d",
            "dataType": "string",
            "modifiedTime": "2026-10-23T15:55:44.386667",
            "structureModifiedTime": "2026-10-23T04:53:25.99"
          },
          {
            "name": "Step Duration Subtext",
            "description": "Dynamic secondary context for Total Step Runtime card showing average duration per step and performance status threshold (Fast < 1s, Moderate 1-3s, Slow > 3s)",
            "expression": "VAR _Avg = COALESCE(AVERAGE('Step'[duration_seconds]), 0)\nVAR _Count = COUNTROWS('Step')\nVAR _Status = \n    SWITCH(\n        TRUE(),\n        _Count = 0, \"⚪ No Data\",\n        _Avg < 1.0, \"🟢 Fast (< 1.0s)\",\n        _Avg <= 3.0, \"🟡 Moderate (1s - 3s)\",\n        \"🔴 Slow (> 3.0s)\"\n    )\nRETURN\n    \"Avg: \" & FORMAT(_Avg, \"0.00\") & \"s/step | \" & _Status",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "4d08487c-af99-432e-b3b1-2f4c29ab4671",
            "dataType": "string",
            "modifiedTime": "2026-10-23T05:08:22.113333",
            "structureModifiedTime": "2026-10-23T04:53:25.99"
          },
          {
            "name": "Step Rows Subtext",
            "description": "Dynamic secondary context for Step Rows Processed card showing inserted rows and yield percentage with health indicator",
            "expression": "VAR _Processed = [Total Step Rows Processed]\nVAR _Inserted = [Total Step Rows Inserted]\nVAR _Yield = DIVIDE(_Inserted, _Processed, 0)\nVAR _Icon = \n    SWITCH(\n        TRUE(),\n        _Processed = 0, \"⚪\",\n        _Yield >= 0.99, \"🟢\",\n        _Yield >= 0.95, \"🟡\",\n        \"🔴\"\n    )\nRETURN\n    \"Inserted: \" & FORMAT(_Inserted, \"#,##0\") & \" | Yield: \" & _Icon & \" \" & FORMAT(_Yield, \"0.00%\")",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "f6e75b7b-abc8-409d-a5d7-5925729275a8",
            "dataType": "string",
            "modifiedTime": "2026-10-23T05:15:42.736667",
            "structureModifiedTime": "2026-10-23T05:15:42.416667"
          },
          {
            "name": "Step Rejected Subtext",
            "description": "Dynamic secondary context for Step Rows Rejected card showing rejection rate percentage and number of distinct steps affected",
            "expression": "VAR _Processed = [Total Step Rows Processed]\nVAR _RejectRate = [Step Rejection Rate Pct]\nVAR _TotalSteps = DISTINCTCOUNT('Step'[step_name])\nVAR _AffectedSteps = CALCULATE(DISTINCTCOUNT('Step'[step_name]), 'Step'[rows_rejected] > 0) + 0\nVAR _Icon = \n    SWITCH(\n        TRUE(),\n        _Processed = 0 && _TotalSteps = 0, \"⚪\",\n        _RejectRate <= 0.02, \"🟢\",\n        _RejectRate <= 0.05, \"🟡\",\n        \"🔴\"\n    )\nRETURN\n    \"Reject Rate: \" & _Icon & \" \" & FORMAT(_RejectRate, \"0.00%\") & \" | Affected: \" & _AffectedSteps & \"/\" & _TotalSteps & \" steps\"",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "6071acec-bfb8-4f80-9a6a-1c5d914bd0ef",
            "dataType": "string",
            "modifiedTime": "2026-10-23T05:15:42.736667",
            "structureModifiedTime": "2026-10-23T05:15:42.416667"
          },
          {
            "name": "Total Process Stages Label",
            "description": "Formatted count of distinct ETL process stages (e.g. 6 Stages) for Card 5 callout on Step Performance page",
            "expression": "\nVAR _Stages = DISTINCTCOUNT('Step'[process_name])\nRETURN\n    IF(\n        _Stages = 1,\n        \"1 Stage\",\n        FORMAT(_Stages, \"#,##0\") & \" Stages\"\n    )",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "3a86a73f-f475-4985-a7d2-82ac33fa86ca",
            "dataType": "string",
            "modifiedTime": "2026-10-23T05:41:41.896667",
            "structureModifiedTime": "2026-10-23T05:39:02.483333"
          },
          {
            "name": "Process Stages Subtext",
            "description": "Dynamic secondary context for Process Stages card showing the heaviest process stage alias, its share of total runtime, and duration",
            "expression": "VAR _StageCount = DISTINCTCOUNT('Step'[process_name])\nVAR _TotalContextSec = CALCULATE(SUM('Step'[duration_seconds]), REMOVEFILTERS('Step'[process_name], 'Step'[step_name]))\nVAR _TopStageTable = \n    TOPN(\n        1,\n        ADDCOLUMNS(\n            VALUES('Step'[process_name]),\n            \"@StageSec\", CALCULATE(SUM('Step'[duration_seconds])),\n            \"@StageRows\", CALCULATE(SUM('Step'[rows_processed]))\n        ),\n        [@StageSec], DESC,\n        [@StageRows], DESC\n    )\nVAR _TopStageRaw = MAXX(_TopStageTable, 'Step'[process_name])\nVAR _TopStageSec = COALESCE(MAXX(_TopStageTable, [@StageSec]), 0)\nVAR _Share = DIVIDE(_TopStageSec, _TotalContextSec, 0)\nVAR _TopStageAlias = \n    SWITCH(\n        _TopStageRaw,\n        \"STG_TO_RAW\", \"STG→RAW\",\n        \"RAW_TO_ODS\", \"RAW→ODS\",\n        \"ODS_TO_DWH\", \"ODS→DWH\",\n        \"DWH_MAINTENANCE\", \"Maintenance\",\n        \"DWH_RECONCILIATION\", \"Reconcile\",\n        \"DWH_DIM_ENRICHMENT\", \"Enrichment\",\n        _TopStageRaw\n    )\nVAR _SecFormatted = \n    IF(\n        _TopStageSec < 60,\n        FORMAT(_TopStageSec, \"#,##0\") & \"s\",\n        FORMAT(INT(_TopStageSec / 60), \"#,##0\") & \"m \" & FORMAT(MOD(_TopStageSec, 60), \"00\") & \"s\"\n    )\nVAR _Icon = \n    SWITCH(\n        TRUE(),\n        _StageCount = 0 || _TotalContextSec = 0, \"⚪\",\n        _Share > 0.50, \"🔴\",\n        _Share >= 0.35, \"🟡\",\n        \"🟢\"\n    )\nVAR _Prefix = IF(_StageCount = 1, \"Stage: \", \"Heaviest: \")\nRETURN\n    IF(\n        _StageCount = 0,\n        \"⚪ No Data\",\n        _Prefix & _TopStageAlias & \" | \" & _Icon & \" \" & FORMAT(_Share, \"0.0%\") & \" (\" & _SecFormatted & \")\"\n    )",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "805d59a8-48e1-42e6-8d20-06216b14d2db",
            "dataType": "string",
            "modifiedTime": "2026-10-23T05:39:02.673333",
            "structureModifiedTime": "2026-10-23T05:39:02.483333"
          },
          {
            "name": "Error Drilldown Subtext",
            "description": "Dynamic secondary context for Quarantined Errors card on Data Quality page showing distinct rejected physical rows and multi-fault violations",
            "expression": "VAR _TotalErrors = [Total Quarantined Errors]\nVAR _RejectedRows = \n    COUNTROWS(\n        SUMMARIZE(\n            'Error',\n            'Error'[batch_id],\n            'Error'[table_name],\n            'Error'[source_file_name],\n            'Error'[source_row_number]\n        )\n    ) + 0\nVAR _MultiFault = MAX(0, _TotalErrors - _RejectedRows)\nRETURN\n    \"Rejected Rows: \" & FORMAT(_RejectedRows, \"#,##0\") & \" | Multi-fault: \" & FORMAT(_MultiFault, \"#,##0\")",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "35e2cb4a-f2e1-4695-a9c4-61f96e0211cd",
            "dataType": "string",
            "modifiedTime": "2026-10-23T13:15:57.07",
            "structureModifiedTime": "2026-10-23T13:15:56.946667"
          },
          {
            "name": "Affected Files Label",
            "description": "Formatted count of distinct source CSV files containing errors (e.g. 36 Files) for Card 2 callout on Data Quality page",
            "expression": "VAR _Files = DISTINCTCOUNT('Error'[source_file_name])\nRETURN\n    IF(\n        _Files = 1,\n        \"1 File\",\n        FORMAT(_Files, \"#,##0\") & \" Files\"\n    )",
            "displayFolder": "03. Data Quality & Errors",
            "lineageTag": "ee471eae-a528-4acc-be0b-ecc6b646bf42",
            "dataType": "string",
            "modifiedTime": "2026-10-23T14:00:43.986667",
            "structureModifiedTime": "2026-10-23T14:00:43.846667"
          },
          {
            "name": "Affected Files Subtext",
            "description": "Dynamic secondary context for Affected Source Files card showing total ingested files and affected tables out of total tables dynamically counted from Reconciliation",
            "expression": "\nVAR _TotalFiles = COALESCE(SUM('Batch'[source_file_count]), 0)\nVAR _AffectedTables = DISTINCTCOUNT('Error'[table_name]) + 0\nVAR _TotalTables = \n    CALCULATE(\n        DISTINCTCOUNT('Reconciliation'[entity_name]),\n        ALL('Reconciliation')\n        )\nRETURN\n    \"Total Files: \" & FORMAT(_TotalFiles, \"#,##0\") & \" | Tables: \" & _AffectedTables & \"/\" & _TotalTables & \" Affected\"",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "7a2a3b02-4ac2-406c-87e5-bc8cc23af8ae",
            "dataType": "string",
            "modifiedTime": "2026-10-23T14:51:32.66",
            "structureModifiedTime": "2026-10-23T14:00:43.846667"
          },
          {
            "name": "Violated Columns Label",
            "description": "Formatted count of distinct columns encountering data quality errors (e.g. 12 Columns) for Card 4 callout on Data Quality page",
            "expression": "VAR _Cols = DISTINCTCOUNT('Error'[column_name])\nRETURN\n    IF(\n        _Cols = 1,\n        \"1 Column\",\n        FORMAT(_Cols, \"#,##0\") & \" Columns\"\n    )",
            "displayFolder": "03. Data Quality & Errors",
            "lineageTag": "5126db29-2f78-4be0-a495-6d92385a043c",
            "dataType": "string",
            "modifiedTime": "2026-10-23T14:07:38.5",
            "structureModifiedTime": "2026-10-23T14:07:38.273333"
          },
          {
            "name": "Violated Columns Subtext",
            "description": "Dynamic secondary context for Violated Columns card showing count of triggered DQ rules and error categories",
            "expression": "VAR _TotalErrors = [Total Quarantined Errors]\nVAR _Rules = DISTINCTCOUNT('Error'[error_type]) + 0\nVAR _Categories = DISTINCTCOUNT('Error'[error_category]) + 0\nRETURN\n    IF(\n        _TotalErrors = 0,\n        \"⚪ No Rules Triggered\",\n        \"DQ Rules: \" & FORMAT(_Rules, \"#,##0\") & \" | Categories: \" & FORMAT(_Categories, \"#,##0\")\n    )",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "329f0bbc-8f57-4003-a7fa-2e751bc38808",
            "dataType": "string",
            "modifiedTime": "2026-10-23T14:57:38.403333",
            "structureModifiedTime": "2026-10-23T14:07:38.273333"
          },
          {
            "name": "True Data Defects",
            "description": "Total actionable data quality defects formatted as exact integer (e.g. 1,852) so Card visual does not abbreviate to K",
            "expression": "\n    CALCULATE(\n        COUNTROWS('Error'),\n        'Error'[error_type] <> \"EXCLUDED_ORDER_CANCELLED\"\n    ) + 0",
            "formatString": "#,0",
            "displayFolder": "03. Data Quality & Errors",
            "lineageTag": "4fb113f7-a85b-4d11-8a18-521243a30ead",
            "dataType": "int64",
            "modifiedTime": "2026-10-23T15:19:52.846667",
            "structureModifiedTime": "2026-10-23T15:01:45.683333"
          },
          {
            "name": "Data Defects Subtext",
            "description": "Dynamic secondary context for True Data Defects card showing defect impact share and count of cancelled orders",
            "expression": "VAR _TotalErrors = [Total Quarantined Errors]\nVAR _Defects = \n    CALCULATE(\n        COUNTROWS('Error'),\n        'Error'[error_type] <> \"EXCLUDED_ORDER_CANCELLED\"\n    ) + 0\nVAR _Cancelled = CALCULATE(COUNTROWS('Error'), 'Error'[error_type] = \"EXCLUDED_ORDER_CANCELLED\") + 0\nVAR _Impact = DIVIDE(_Defects, _TotalErrors, 0)\nRETURN\n    IF(\n        _TotalErrors = 0,\n        \"⚪ No Errors\",\n        \"Impact: \" & FORMAT(_Impact, \"0.0%\") & \" | Cancelled Orders: \" & FORMAT(_Cancelled, \"#,##0\")\n    )",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "f6fa25c5-df12-447f-b86e-e7cc87df690a",
            "dataType": "string",
            "modifiedTime": "2026-10-23T15:22:51.106667",
            "structureModifiedTime": "2026-10-23T15:01:45.683333"
          },
          {
            "name": "Warning Drilldown Subtext",
            "description": "Dynamic secondary context for Operational Warnings card on Data Quality page showing affected tables out of total tables and distinct warning types",
            "expression": "VAR _Warnings = [Total Operational Warnings] + 0\nVAR _AffectedTables = DISTINCTCOUNT('Warning'[table_name]) + 0\nVAR _TotalTables = CALCULATE(DISTINCTCOUNT('Reconciliation'[entity_name]), ALL('Reconciliation'))\nVAR _WarningTypes = DISTINCTCOUNT('Warning'[warning_type]) + 0\nRETURN\n    IF(\n        _Warnings = 0,\n        \"⚪ No Warnings\",\n        \"Tables: \" & _AffectedTables & \"/\" & _TotalTables & \" Affected | Warning Types: \" & FORMAT(_WarningTypes, \"#,##0\")\n    )",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "a7691d8b-256c-4576-9f48-f578001f57fe",
            "dataType": "string",
            "modifiedTime": "2026-10-23T15:36:08.61",
            "structureModifiedTime": "2026-10-23T15:36:08.47"
          },
          {
            "name": "Operational Warning Rate Pct",
            "description": "Percentage of ODS staged records flagged with operational warnings across batches",
            "expression": "VAR _Warnings = [Total Operational Warnings]\nVAR _OdsRows = \n    IF(\n        ISFILTERED('Warning'[batch_id]) && NOT ISFILTERED('Batch'[batch_id]),\n        CALCULATE(\n            [Total Records Staged ODS],\n            TREATAS(VALUES('Warning'[batch_id]), 'Reconciliation'[batch_id])\n        ),\n        [Total Records Staged ODS]\n    )\nRETURN\n    DIVIDE(_Warnings, _OdsRows, 0)",
            "formatString": "0.00%",
            "displayFolder": "03. Data Quality & Errors",
            "lineageTag": "16acf3e7-d07c-4dc9-aec3-ad64d5d522d0",
            "dataType": "double",
            "modifiedTime": "2026-10-24T02:29:32.176667",
            "structureModifiedTime": "2026-10-24T02:29:32.026667"
          },
          {
            "name": "Quarantined Error Rate Pct",
            "description": "Percentage of RAW ingested records quarantined due to data quality violations across batches",
            "expression": "VAR _Errors = [Total Quarantined Errors]\nVAR _RawRows = \n    IF(\n        ISFILTERED('Error'[batch_id]) && NOT ISFILTERED('Batch'[batch_id]),\n        CALCULATE(\n            [Total Records Ingested RAW],\n            TREATAS(VALUES('Error'[batch_id]), 'Reconciliation'[batch_id])\n        ),\n        [Total Records Ingested RAW]\n    )\nRETURN\n    DIVIDE(_Errors, _RawRows, 0)",
            "formatString": "0.00%",
            "displayFolder": "03. Data Quality & Errors",
            "lineageTag": "c73ab040-651d-4788-8002-e2dad2a7ad08",
            "dataType": "double",
            "modifiedTime": "2026-10-24T02:51:20.563333",
            "structureModifiedTime": "2026-10-24T02:51:20.373333"
          },
          {
            "name": "Total ODS to DWH Variance",
            "description": "Total row count discrepancy between ODS and DWH layers (negative indicates SCD2 historical version expansion in DWH)",
            "expression": "COALESCE(SUM('Reconciliation'[ods_to_dwh_variance]), 0)",
            "formatString": "#,##0",
            "displayFolder": "04. Layer Reconciliation",
            "lineageTag": "af402bcb-06c6-4f46-b3ba-211739b5eeab",
            "dataType": "int64",
            "modifiedTime": "2026-10-24T03:08:00.733333",
            "structureModifiedTime": "2026-10-24T03:08:00.506667"
          },
          {
            "name": "Reconciliation Checks Label",
            "description": "Formatted count of entity reconciliation checks (e.g. 72 Checks) for Card 1 callout on Layer Reconciliation page",
            "expression": "VAR _Checks = COUNTROWS('Reconciliation') + 0\nRETURN\n    IF(\n        _Checks = 1,\n        \"1 Check\",\n        FORMAT(_Checks, \"#,##0\") & \" Checks\"\n    )",
            "displayFolder": "04. Layer Reconciliation",
            "lineageTag": "7c50e5fd-785d-483d-b97f-edf824e72e0c",
            "dataType": "string",
            "modifiedTime": "2026-10-24T03:23:24.43",
            "structureModifiedTime": "2026-10-24T03:23:23.966667"
          },
          {
            "name": "Reconciliation Checks Subtext",
            "description": "Dynamic secondary context for Reconciliation Checks card showing exact matches and SCD variance count",
            "expression": "VAR _Total = COUNTROWS('Reconciliation') + 0\nVAR _Exact = CALCULATE(COUNTROWS('Reconciliation'), 'Reconciliation'[audit_status] = \"RECONCILED (Valid Audit)\") + 0\nVAR _Variance = CALCULATE(COUNTROWS('Reconciliation'), 'Reconciliation'[audit_status] <> \"RECONCILED (Valid Audit)\") + 0\nRETURN\n    IF(\n        _Total = 0,\n        \"⚪ No Data\",\n        \"🟢 \" & FORMAT(_Exact, \"#,##0\") & \" Exact Match | 🟡 \" & FORMAT(_Variance, \"#,##0\") & \" SCD Variances\"\n    )",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "9047045a-a07c-4cca-9bbd-dceb0c078ada",
            "dataType": "string",
            "modifiedTime": "2026-10-24T03:23:24.43",
            "structureModifiedTime": "2026-10-24T03:23:23.966667"
          },
          {
            "name": "ODS Staged Subtext",
            "description": "Dynamic secondary context for ODS Staged Volume card showing total RAW volume and deduplicated rows in ODS",
            "expression": "VAR _Raw = [Total Records Ingested RAW] + 0\nVAR _RawToOdsDiff = [Total RAW to ODS Variance]\nVAR _Errors = [Total Reconciliation Errors]\nVAR _Deduped = MAX(0, _RawToOdsDiff - _Errors)\nRETURN\n    IF(\n        _Raw = 0,\n        \"⚪ No Data\",\n        \"RAW: \" & FORMAT(_Raw, \"#,##0\") & \" | Deduped: \" & FORMAT(_Deduped, \"#,##0\") & \" rows\"\n    )",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "b795c92e-b26e-430b-a1bf-f6bc212c9d68",
            "dataType": "string",
            "modifiedTime": "2026-10-24T03:23:24.43",
            "structureModifiedTime": "2026-10-24T03:23:23.966667"
          },
          {
            "name": "DWH Loaded Subtext",
            "description": "Dynamic secondary context for DWH Loaded Volume card showing SCD2 historical version rows added and unaccounted data loss check",
            "expression": "VAR _Dwh = [Total Records Loaded DWH] + 0\nVAR _OdsToDwhVar = [Total ODS to DWH Variance]\nVAR _Scd2Added = MAX(0, -_OdsToDwhVar)\nVAR _UnaccountedLoss = SUMX('Reconciliation', MAX(0, 'Reconciliation'[ods_to_dwh_variance])) + 0\nVAR _LossText = IF(_UnaccountedLoss = 0, \"🟢 0\", \"🔴 \" & FORMAT(_UnaccountedLoss, \"#,##0\"))\nVAR _ScdPrefix = IF(_Scd2Added > 0, \"+\", \"\")\nRETURN\n    IF(\n        _Dwh = 0,\n        \"⚪ No Data\",\n        \"SCD2 Versions: \" & _ScdPrefix & FORMAT(_Scd2Added, \"#,##0\") & \" | Unaccounted: \" & _LossText\n    )",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "0aa722dd-91a3-49ae-96b5-08d3e5313bf7",
            "dataType": "string",
            "modifiedTime": "2026-10-24T03:23:24.43",
            "structureModifiedTime": "2026-10-24T03:23:23.966667"
          },
          {
            "name": "Retention Rate Subtext",
            "description": "Dynamic secondary context for Data Retention Rate card showing retention health status and net row difference from RAW to DWH",
            "expression": "VAR _Raw = [Total Records Ingested RAW] + 0\nVAR _Dwh = [Total Records Loaded DWH] + 0\nVAR _Rate = [Overall Data Retention Rate Pct]\nVAR _NetDiff = _Dwh - _Raw\nVAR _DiffSign = IF(_NetDiff > 0, \"+\", \"\")\nVAR _Status = \n    SWITCH(\n        TRUE(),\n        _Raw = 0, \"⚪ No Data\",\n        _Rate >= 0.98, \"🟢 Healthy (>= 98%)\",\n        _Rate >= 0.95, \"🟡 Moderate (95% - 98%)\",\n        \"🔴 Low (< 95%)\"\n    )\nRETURN\n    IF(\n        _Raw = 0,\n        \"⚪ No Data\",\n        _Status & \" | Net Diff: \" & _DiffSign & FORMAT(_NetDiff, \"#,##0\")\n    )",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "31ac0e32-c35c-4d45-b5d7-af3dd1b42137",
            "dataType": "string",
            "modifiedTime": "2026-10-24T03:23:24.43",
            "structureModifiedTime": "2026-10-24T03:23:23.966667"
          },
          {
            "name": "Dimension Changes Subtext",
            "description": "Dynamic secondary context for SCD2 Audit Changes card showing unique business keys, affected dimensions, and tracked attributes",
            "expression": "VAR _Changes = [Total Dimension Changes] + 0\nVAR _Keys = DISTINCTCOUNT('Audit'[business_id]) + 0\nVAR _Dims = DISTINCTCOUNT('Audit'[dimension_name]) + 0\nVAR _Attrs = DISTINCTCOUNT('Audit'[column_name]) + 0\nRETURN\n    IF(\n        _Changes = 0,\n        \"⚪ No SCD2 Changes\",\n        \"Unique Keys: \" & FORMAT(_Keys, \"#,##0\") & \" | Dims: \" & _Dims & \" | Attrs: \" & _Attrs\n    )",
            "displayFolder": "06. Card Subtexts",
            "lineageTag": "82f5f1f8-9c35-4577-8b40-b4030e16e765",
            "dataType": "string",
            "modifiedTime": "2026-10-24T03:23:24.43",
            "structureModifiedTime": "2026-10-24T03:23:23.966667"
          }
        ]
      },
