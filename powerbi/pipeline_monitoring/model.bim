            }
          }
        ],
        "measures": [
          {
            "name": "Latest Batch ID",
            "description": "Batch ID of the latest pipeline execution",
            "expression": "CALCULATE(MAX('Batch'[batch_id]), ALL('Batch'))",
            "formatString": "#,##0",
            "displayFolder": "01. Pipeline Status & Health",
            "lineageTag": "b8f6e8cf-c591-4b20-b5c8-2d50ad7b79c5",
            "dataType": "int64",
            "modifiedTime": "2026-10-16T02:39:24.62",
            "structureModifiedTime": "2026-10-16T02:34:58.51"
          },
          {
            "name": "Latest Batch Status",
            "description": "Status of the latest executed batch",
            "expression": "CALCULATE(\n    SELECTEDVALUE('Batch'[batch_status]),\n    FILTER(\n        ALL('Batch'),\n        'Batch'[batch_id] = [Latest Batch ID]\n    )\n)",
            "displayFolder": "01. Pipeline Status & Health",
            "lineageTag": "1f89c1ec-de2d-49bd-a8e0-a471ca86e654",
            "dataType": "string",
            "modifiedTime": "2026-10-16T02:39:24.62",
            "structureModifiedTime": "2026-10-16T02:34:58.513333"
          },
          {
            "name": "Pipeline Health KPI",
            "description": "Visual pipeline health badge with indicator icon",
            "expression": "SWITCH(\n    [Latest Batch Status],\n    \"SUCCESS\", \"🟢 Healthy\",\n    \"RUNNING\", \"🔵 In Progress\",\n    \"PARTIAL\", \"🟡 Degraded\",\n    \"FAILED\",  \"🔴 Critical\",\n    \"⚪ Unknown\"\n)",
            "displayFolder": "01. Pipeline Status & Health",
            "lineageTag": "f8ee61db-a91c-43dd-8445-d3ff114802a6",
            "dataType": "string",
            "modifiedTime": "2026-10-16T02:34:58.576667",
            "structureModifiedTime": "2026-10-16T02:34:58.513333"
          },
          {
            "name": "Hours Since Last Run",
            "description": "Number of hours elapsed since the latest batch started",
            "expression": "VAR _LastStartTime = \n    CALCULATE(\n        MAX('Batch'[start_time]),\n        FILTER(\n            ALL('Batch'),\n            'Batch'[batch_id] = [Latest Batch ID]\n        )\n    )\nRETURN\n    IF(NOT ISBLANK(_LastStartTime), DATEDIFF(_LastStartTime, NOW(), HOUR), BLANK())",
            "formatString": "#,##0",
            "displayFolder": "01. Pipeline Status & Health",
            "lineageTag": "053f12a4-48e3-432b-bfd0-b56618bbf785",
            "dataType": "int64",
            "modifiedTime": "2026-10-16T02:39:24.62",
            "structureModifiedTime": "2026-10-16T02:34:58.513333"
          },
          {
            "name": "Data Freshness Status",
            "description": "SLA Data Freshness indicator (< 24h is fresh)",
            "expression": "VAR _Hours = [Hours Since Last Run]\nRETURN\n    SWITCH(\n        TRUE(),\n        ISBLANK(_Hours), \"⚪ Unknown\",\n        _Hours <= 24, \"🟢 Fresh (< 24h)\",\n        _Hours <= 36, \"🟡 Warning (24h - 36h)\",\n        \"🔴 Stale (> 36h)\"\n    )",
            "displayFolder": "01. Pipeline Status & Health",
            "lineageTag": "b221da25-2778-429e-be90-fbbf1b9da772",
            "dataType": "string",
            "modifiedTime": "2026-10-16T02:34:58.576667",
            "structureModifiedTime": "2026-10-16T02:34:58.513333"
          },
          {
            "name": "Total Batches Executed",
            "description": "Total pipeline batches recorded in control layer",
            "expression": "COUNTROWS('Batch')",
            "formatString": "#,##0",
            "displayFolder": "02. Execution & Throughput",
            "lineageTag": "bc643ac2-5caf-439f-b0e1-cd7d89fef164",
            "dataType": "int64",
