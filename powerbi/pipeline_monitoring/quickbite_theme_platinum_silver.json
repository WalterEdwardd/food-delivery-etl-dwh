{
  "name": "QuickBite Platinum Silver Luxury Theme",
  "dataColors": [
    "#009E46",
    "#0F2C67",
    "#FF8F00",
    "#C40C0C",
    "#7C3AED",
    "#00B14F",
    "#0D9488",
    "#64748B"
  ],
  "background": "#F1F5F9",
  "foreground": "#0F172A",
  "tableAccent": "#009E46",
  "good": "#009E46",
  "neutral": "#FF8F00",
  "bad": "#C40C0C",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E2E8F0" } },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#64748B" } },
            "position": "Outer",
            "preset": "Custom",
            "shadowSpread": 0,
            "shadowBlur": 14,
            "angle": 90,
            "shadowDistance": 3,
            "transparency": 86
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#0F172A" } },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#64748B" } },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F1F5F9" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#E2E8F0" } },
            "transparency": 0
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "accentBar": [
          {
            "$id": "default",
            "show": true,
            "position": "Left",
            "color": { "solid": { "color": "#009E46" } },
            "width": 4,
            "transparency": 0
          }
        ],
        "fillCustom": [
          {
            "$id": "default",
            "show": true,
            "fillColor": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "$id": "default",
            "show": true,
            "lineColor": { "solid": { "color": "#E2E8F0" } },
            "transparency": 20,
            "width": 1
          }
        ],
        "shapeCustomRectangle": [
          {
            "$id": "default",
            "rectangleRoundedCurve": 10
          }
        ],
        "divider": [
          {
            "$id": "default",
            "show": true,
            "dividerColor": { "solid": { "color": "#E2E8F0" } },
            "dividerTransparency": 0,
            "dividerIgnorePadding": true
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "outlineColor": { "solid": { "color": "#E2E8F0" } },
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#F1F5F9" } },
            "rowPadding": 6
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#065F46" } },
            "backColor": { "solid": { "color": "#ECFDF5" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1E293B" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "backColorSecondary": { "solid": { "color": "#F8FAFC" } }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "outlineColor": { "solid": { "color": "#E2E8F0" } },
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#F1F5F9" } },
            "rowPadding": 6
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#065F46" } },
            "backColor": { "solid": { "color": "#ECFDF5" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1E293B" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    },
    "gauge": {
      "*": {
        "dataLabels": [
          {
            "color": { "solid": { "color": "#009E46" } }
          }
        ],
        "target": [
          {
            "color": { "solid": { "color": "#FF8F00" } }
          }
        ]
      }
    }
  }
}
