# ==============================================================================
# Food Delivery ETL & Data Warehouse Environment Configuration Template
# Copy this file to '.env' and adjust the variables for your target environment.
# ==============================================================================

# Database Server & Instance (e.g. localhost, localhost\SQLEXPRESS, 10.0.0.5, or db.example.com)
DB_SERVER=localhost\SQLEXPRESS

# Target Database Name
DB_DATABASE=FoodDeliveryDW

# Preferred ODBC Driver (e.g. "ODBC Driver 17 for SQL Server" or "ODBC Driver 18 for SQL Server")
DB_DRIVER=ODBC Driver 17 for SQL Server

# Port (Optional, leave blank for default SQL Server port 1433)
DB_PORT=

# Authentication Mode
# --------------------
# 1. Windows Authentication: Set DB_TRUSTED_CONNECTION=yes, leave USER/PASSWORD blank
DB_TRUSTED_CONNECTION=yes

# 2. SQL Server Authentication: Set DB_TRUSTED_CONNECTION=no and provide USER & PASSWORD
DB_USER=
DB_PASSWORD=

# Security & Network Settings
DB_TRUST_SERVER_CERTIFICATE=yes
DB_TIMEOUT=30
